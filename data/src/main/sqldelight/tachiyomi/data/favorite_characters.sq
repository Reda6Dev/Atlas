CREATE TABLE favorite_characters (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    name_native TEXT,
    image_url TEXT,
    favourites_count INTEGER NOT NULL DEFAULT 0,
    description TEXT,
    role TEXT,
    anilist_media_id INTEGER,
    manga_title TEXT,
    added_at INTEGER NOT NULL DEFAULT 0
);

insert:
INSERT OR REPLACE INTO favorite_characters(id, name, name_native, image_url, favourites_count, description, role, anilist_media_id, manga_title, added_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM favorite_characters WHERE id = ?;

selectById:
SELECT * FROM favorite_characters WHERE id = ?;

selectAll:
SELECT * FROM favorite_characters ORDER BY added_at DESC;
